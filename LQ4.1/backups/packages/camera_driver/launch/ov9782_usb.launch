<?xml version="1.0"?>
<launch>
  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
    <!-- Устройство камеры (измените, если видео-индекс другой) -->
    <param name="video_device" value="/dev/video0" />
    
    <!-- Разрешение и частота кадров -->
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="framerate" value="30" />
    
    <!-- Формат сжатия для обхода узкого горлышка USB 2.0 -->
    <param name="pixel_format" value="mjpeg" />
    
    <!-- Цветовая кодировка на выходе в ROS (OpenCV / OpenVINS любят bgr8 или mono8) -->
    <param name="image_format" value="mono8" />
    <param name="camera_frame_id" value="camera_frame" />
    
    <!-- Метод работы с памятью драйвера Linux (mmap - самый быстрый и без лагов) -->
    <param name="io_method" value="mmap"/>

    <!-- Перенаправляем выходной топик под вашу структуру -->
    <remap from="/usb_cam/image_raw" to="/data"/>
  </node>
</launch>

