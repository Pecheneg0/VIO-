<launch>
  <!-- ========== 1. СЕНСОРЫ ========== -->
  <!-- Камера -->
  <include file="$(find camera_driver)/launch/ov9782_usb.launch" />
  
  <!-- IMU -->
  <include file="$(find mpu6050_driver)/launch/mpu6050_driver.launch" />
  
  <!--  ЛИДАР (обязательно!) -->
  <node pkg="tfmini_ros" 
        type="tfmini_ros_node" 
        name="tfmini_ros_node" 
        output="screen"
        respawn="true"
        respawn_delay="1.0">
    <param name="serial_port" value="/dev/ttyUSB0"/>
    <param name="baud_rate" value="115200"/>
    <param name="frame_id" value="lidar_link"/>
  </node>

  <!-- ========== 2. ТРАНСФОРМАЦИИ ========== -->
  <!-- Лидар смотрит вниз, смещение по Z относительно base_link -->
  <node pkg="tf" type="static_transform_publisher" 
        name="tf_base_to_lidar" 
        args="0 0 -0.05 0 0 0 base_link lidar_link 100" />

  <!-- ========== 3. ВИЗУАЛЬНЫЙ ГИРОСКОП ========== -->
  <node pkg="visual_gyro_estimator" 
        type="visual_gyro_node6.py" 
        name="visual_gyro_node" 
        output="screen"
        respawn="true"
        respawn_delay="2.0">
    <param name="min_features" value="6"/> 
    <param name="quality_level" value="0.06"/>
    <param name="max_flow_error" value="25.0"/>
    <param name="coast_damping" value="0.55"/>
    <param name="kf_Q" value="0.12"/>
    <param name="kf_R" value="0.8"/>
    <param name="cov_growth_rate" value="0.015"/>
    <param name="max_coast_frames" value="45"/>
    <rosparam command="load" file="$(find visual_gyro_estimator)/config/visual_gyro_params.yaml"/>
  </node>

  <!-- ========== ПРЕОБРАЗОВАНИЕ КООРДИНАТ (N-E-U -> WGS84) ========== -->
  <node pkg="visual_gyro_estimator" 
        type="local_to_wgs84.py" 
        name="coord_transform" 
        output="screen"
        respawn="true"
        respawn_delay="2.0">
    
    <!-- Координаты точки старта -->
    <arg name="start_lat" default="55.692065" doc"Широта"/>
    <arg name="start_lon" default="37.516265" doc="Долгота"/>
    <arg name="start_alt" default="150" doc="Высота над уровнем моря"/>
    
    <!-- Геоидная высота для вашего региона (для Москвы/ЦФО ~14.5м) -->
    <param name="geoid_height" value="14.5"/>
    
    <!-- Топики -->
    <param name="odom_topic" value="/drone/odom"/>
    <param name="pub_topic" value="/vio/global_position"/>
  </node>
</launch>
